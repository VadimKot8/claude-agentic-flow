# ---------------------------------------------------------------------------
# MCP Web Search server configuration
# Copy this file to `.env` and fill in the required secrets.
# `from_env()` loads these at startup and validates them.
# ---------------------------------------------------------------------------

# --- Required secrets --------------------------------------------------------
# Tavily API key (required).
TAVILY_API_KEY=

# OpenAI API key (required when LLM_PROVIDER=openai).
OPENAI_API_KEY=

# --- LLM provider / models ---------------------------------------------------
# Provider switch. Supported: openai
LLM_PROVIDER=openai

# Embedding model. Supported OpenAI models:
#   text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
EMBEDDING_MODEL=text-embedding-3-small

# Summarization (chat) model. Supported OpenAI models include:
#   gpt-5, gpt-5-mini, gpt-5-nano, gpt-4.1, gpt-4.1-mini, gpt-4.1-nano,
#   gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-4, gpt-3.5-turbo
SUMMARIZATION_MODEL=gpt-5-mini

# --- ChromaDB cache ----------------------------------------------------------
# Local persistent ChromaDB directory.
CHROMA_PATH=./.chroma

# Collection name.
CHROMA_COLLECTION=web_search_cache

# Time-to-live for cached records, in days. Records older than this are
# evicted on read.
CACHE_TTL_DAYS=30

# Minimum cosine similarity for a cache hit (0.0 - 1.0). The collection uses
# cosine distance, so this is a true cosine similarity. Because reads are
# already constrained by an exact framework_name + framework_version filter, a
# moderate threshold (~0.75) safely matches paraphrased re-asks of the same
# question without pulling in unrelated answers. Raise it to be stricter.
SIMILARITY_THRESHOLD=0.75

# --- Usage / cost reporting --------------------------------------------------
TAVILY_COST_PER_SEARCH_USD=0.015
TAVILY_FREE_TIER_ALLOCATION=1000

# --- HTTP transport ----------------------------------------------------------
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8000

# --- Logging -----------------------------------------------------------------
# Log verbosity. One of: DEBUG, INFO, WARNING, ERROR, CRITICAL.
# At INFO the server logs: each MCP request/response (middleware), the
# web_search and db_search tool request/response, what is stored to the
# ChromaDB cache (upsert), and what is retrieved from it (query).
LOG_LEVEL=INFO
